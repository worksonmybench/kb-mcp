# Public URL the Cloudflare Tunnel serves (no trailing slash)
PUBLIC_BASE_URL=https://kb.example.com

# GitHub OAuth App (github.com/settings/developers -> New OAuth App)
#   Homepage URL:               https://kb.example.com
#   Authorization callback URL: https://kb.example.com/auth/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Comma-separated numeric GitHub user IDs allowed in (curl https://api.github.com/users/<name>)
ALLOWED_GITHUB_IDS=

# Signs the tokens this server issues. Generate once and never change it, or every
# client has to log in again:  openssl rand -hex 32
JWT_SIGNING_KEY=

# Gitea, as reachable from the Docker host
GITEA_URL=http://gitea.example.internal
# Optional. Public repos sync anonymously; for private KB repos, create a token with
# only the read:repository scope (Gitea -> Settings -> Applications)
GITEA_TOKEN=
KB_TOPIC=kb
SYNC_INTERVAL=300

# Optional: the server name clients show, and what the KB covers (finishes the sentence
# "Read-only knowledge base built from ...", part of the instructions agents get).
# KB_NAME=Home KB
# KB_DESCRIPTION=the owner's documentation repos: homelab, house and personal projects
