# Read by deploy/kb-mcp-firewall.sh and deploy/verify-firewall.sh on the host.
# The reverse proxy in front of kb-mcp. Containers also reach Gitea through it on port 80.
PROXY_IP=192.0.2.10
# Resolvers the containers may use, space-separated
DNS_SERVERS="192.0.2.53"
# host:port pairs on your LAN that verify-firewall.sh expects to be unreachable from both
# containers. Include the Docker host's own sshd and anything else worth protecting.
BLOCKED_TARGETS="192.0.2.20:22 192.0.2.1:443"
