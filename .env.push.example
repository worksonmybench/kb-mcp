# kb-sweep-push (pushes the sweep's commits; never runs a model). Root-only: chmod 600.
# Gitea bot account `kb-sweep`, added as a Write collaborator on the kb-tagged doc repos only.
# Token: log in as kb-sweep -> Settings -> Applications, scope write:repository.
GITEA_USER=kb-sweep
GITEA_TOKEN=
# Read by deploy/kb-sweep.sh on the host, not by the container: Uptime Kuma push monitor URL
# without its query string, e.g. http://127.0.0.1:3001/api/push/AbCdEf1234
KUMA_PUSH_URL=
