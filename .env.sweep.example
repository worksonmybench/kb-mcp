# kb-sweep (the container that runs Claude Code). Root-only on the Docker host: chmod 600.
# Long-lived token on the owner's Claude subscription: run `claude setup-token` on any machine
# with Claude Code and paste the result. Or set ANTHROPIC_API_KEY instead to bill the API.
CLAUDE_CODE_OAUTH_TOKEN=
# Gitea, as reachable from the container (through the reverse proxy, see .env.firewall)
GITEA_URL=http://gitea.example.internal
# Optional model override; omit for Claude Code's default.
# SWEEP_MODEL=claude-sonnet-5-5
